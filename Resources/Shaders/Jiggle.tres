[gd_resource type="ShaderMaterial" format=3 uid="uid://cyp3pqnhbfrj3"]

[sub_resource type="Shader" id="Shader_ut4xv"]
code = "shader_type canvas_item;

uniform float jiggle = 5.0;
uniform float speed = 30.0;

void vertex() {
	VERTEX.y += VERTEX_ID % 2 == 0 ? cos((TIME * speed) + VERTEX.x + float(VERTEX_ID * 10)) * jiggle : sin((TIME * speed) + VERTEX.x + float(VERTEX_ID * 10)) * jiggle;
}"

[resource]
shader = SubResource("Shader_ut4xv")
shader_parameter/jiggle = 2.0
shader_parameter/speed = 5.0
