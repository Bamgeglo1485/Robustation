[gd_resource type="ShaderMaterial" format=3 uid="uid://c431ei1tq3rl8"]

[sub_resource type="Shader" id="Shader_mbu7o"]
code = "shader_type canvas_item;

uniform float amplitude: hint_range(0.0, 1.0);
uniform float speed: hint_range(0.0, 2.0);
void vertex() {
	// Called for every vertex the material is visible on.
	float time = TIME * (30. * speed);
	float wobbling = sin(time) * 40. * amplitude;
	float direction = sin(time / 2.);
	VERTEX += vec2(direction * wobbling,wobbling);
	//VERTEX += direction;
}"

[resource]
shader = SubResource("Shader_mbu7o")
shader_parameter/amplitude = 0.2970000141075
shader_parameter/speed = 0.2150000102125
